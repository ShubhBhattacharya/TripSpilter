# ==============================================================================
# TripSplit Environment Variables Configuration (100% Free-Tier Services)
# ==============================================================================
# Copy this file to .env.local and fill in your actual values:
# cp .env.local.example .env.local
# DO NOT commit .env.local to Git repository.

# ------------------------------------------------------------------------------
# 1. Supabase (Free Tier: 50,000 monthly active users, 500MB DB, Auth included)
# Obtain from: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. AI Receipt Scanning (Optional Free Tier: Google AI Studio Gemini API)
# Obtain from: https://aistudio.google.com/app/apikey (Free tier available)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. Distributed Rate Limiting (Optional Free Tier: Upstash Redis)
# Obtain from: https://upstash.com (Free tier: 10,000 commands/day)
# If omitted, TripSplit automatically uses in-memory token bucket rate limiting.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 4. Preview / Demo Mode Toggle
# Set to 'false' in production or when using live Supabase credentials.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
