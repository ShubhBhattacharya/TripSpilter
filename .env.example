# ==============================================================================
# TripSplit Environment Variables Configuration
# Copy this file to .env.local (never commit .env.local to Git):
#   cp .env.example .env.local
# ==============================================================================

# 1. DATABASE & AUTH (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Set to true only after configuring Twilio/MessageBird SMS provider in Supabase Auth
NEXT_PUBLIC_SUPABASE_PHONE_ENABLED=false
# SERVER-ONLY! Never expose in NEXT_PUBLIC_* variables. Only needed for payment webhooks/admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# 2. CENTRAL AI TRAVEL COMPANION (Server-only)
# AI_PROVIDER accepts: openai | gemini | auto (default: auto)
AI_PROVIDER=auto
# Official current defaults: gpt-4o-mini (OpenAI) or gemini-2.0-flash (Gemini)
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 3. REAL-TIME TRAVEL & MAPS PROVIDERS (Server-only)
# Google Maps Platform (Places API New, Routes API, Photos)
GOOGLE_MAPS_API_KEY=
# Licensed stock photography (Unsplash API)
UNSPLASH_ACCESS_KEY=
# Authorized Travel Booking / Inventory Providers (e.g. Amadeus, Duffel, Hotelbeds, Viator)
HOTEL_PROVIDER_API_KEY=
FLIGHT_PROVIDER_API_KEY=
FLIGHT_PROVIDER_API_SECRET=
ACTIVITIES_PROVIDER_API_KEY=
# Commercial Weather & Currency Providers (optional; falls back to clearly labelled indicative APIs)
WEATHER_PROVIDER_API_KEY=
CURRENCY_PROVIDER_API_KEY=

# 4. PAYMENT GATEWAY & VERIFIED WEBHOOKS (Server-only)
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# 5. DISTRIBUTED RATE LIMITING (Optional: Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 6. EXPLICIT DEMO MODE TOGGLE
NEXT_PUBLIC_DEMO_MODE=false
